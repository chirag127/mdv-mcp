# mdv-mcp configuration — copy to .env and fill in.

# NVIDIA API key from https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Absolute path to the markdown/Obsidian vault root.
VAULT_ROOT=C:/g/md

# Embedding model + endpoint (defaults shown).
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Where to store the on-disk vector index (defaults to <VAULT_ROOT>/.mdv-cache).
# MDV_CACHE_DIR=C:/g/md/.mdv-cache
