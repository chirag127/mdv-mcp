{
  "name": "@chirag127/mdv-mcp",
  "version": "2.0.0",
  "description": "Local MCP server for Obsidian/markdown vaults. NVIDIA nemotron-3-embed-1b semantic search, pure-JS int8 vector store, OKF frontmatter, wikilinks, memory, live file watcher.",
  "type": "module",
  "main": "src/index.mjs",
  "bin": {
    "mdv-mcp": "src/index.mjs"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "dev": "node --watch src/index.mjs",
    "selftest": "node src/selftest.mjs",
    "reindex": "node src/reindex.mjs"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obsidian",
    "markdown",
    "vault",
    "semantic-search",
    "embeddings",
    "nvidia",
    "nemotron",
    "okf",
    "knowledge-management",
    "ai"
  ],
  "author": "Chirag Singhal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chirag127/mdv-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/chirag127/mdv-mcp/issues"
  },
  "homepage": "https://github.com/chirag127/mdv-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chokidar": "^3.6.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=18"
  }
}
