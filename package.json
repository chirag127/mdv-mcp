{
  "name": "@chirag127/mdv-mcp",
  "version": "3.0.0",
  "description": "Local MCP server for Obsidian/markdown vaults. NVIDIA nemotron-3-embed-1b semantic search, pure-JS int8 vector store, OKF v0.2 frontmatter, wikilinks, memory, live file watcher. Folder-scoped via --vault arg or MCP roots.",
  "type": "module",
  "main": "src/index.mjs",
  "bin": {
    "mdv-mcp": "src/index.mjs"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "start:http": "node src/index.mjs --http",
    "dev": "node --watch src/index.mjs",
    "selftest": "node src/selftest.mjs",
    "reindex": "node src/reindex.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obsidian",
    "markdown",
    "vault",
    "semantic-search",
    "embeddings",
    "nvidia",
    "nemotron",
    "okf",
    "knowledge-management",
    "vector-search",
    "ai"
  ],
  "author": "Chirag Singhal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chirag127/mdv-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/chirag127/mdv-mcp/issues"
  },
  "homepage": "https://mdv-mcp.oriz.in",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^3.6.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7"
  }
}
